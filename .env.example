# ==============================================================================
# IMMIGRATION AGENCY VISA PAYMENT PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Safe placeholders only. Never commit real credentials to version control.
# Configure these variables in the Netlify Site Configuration: Site configuration > Environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Managed Serverless SQLite / Turso libSQL)
# ------------------------------------------------------------------------------
# On Netlify, the local filesystem is ephemeral and read-only.
# A managed libSQL database (e.g. Turso) must be configured for persistent records.
# Example: libsql://luxembourg-portal-prod-your-org.turso.io
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"

# Authentication token for your managed Turso libSQL cluster
TURSO_AUTH_TOKEN="your-turso-jwt-auth-token-here"

# (Optional fallback for local offline testing - defaults to file:data/portal.sqlite if unset)
# DATABASE_URL="file:data/portal.sqlite"

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY & SESSION SIGNING
# ------------------------------------------------------------------------------
# Cryptographic secret used to sign HMAC-SHA256 session cookies (min 32 characters)
SESSION_SECRET="generate-a-secure-random-32-byte-hex-string-for-production"

# ------------------------------------------------------------------------------
# 3. INITIAL ADMINISTRATOR BOOTSTRAP
# ------------------------------------------------------------------------------
# Used ONLY when initializing the first administrator account if the table is empty.
# In production, administrators are forced to change this upon initial login.
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-initial-bootstrap-password"

# ------------------------------------------------------------------------------
# 4. PERSISTENT OBJECT STORAGE (Netlify Blobs)
# ------------------------------------------------------------------------------
# When deployed to Netlify, Netlify Blobs is automatically enabled with zero configuration.
# If testing Netlify Blobs locally with Netlify CLI, set these optional tokens:
# NETLIFY_SITE_ID="your-netlify-site-id"
# NETLIFY_AUTH_TOKEN="your-netlify-personal-access-token"

# ------------------------------------------------------------------------------
# 5. ENVIRONMENT & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-custom-domain.netlify.app"

# ------------------------------------------------------------------------------
# 6. OPTIONAL PAYMENT PROVIDER INTEGRATIONS (When Transitioning Out of Demo Mode)
# ------------------------------------------------------------------------------
# Card payments remain in Demo simulation mode until valid live credentials are provided.
# Demo mode terminates with the exact status message: "Payment failed".
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""

# PayPal Express credentials (when regional availability is enabled)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
